generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("USER") // ADMIN, INVENTORY_MANAGER, WAREHOUSE_STAFF
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Warehouse {
  id        String     @id @default(cuid())
  name      String
  code      String     @unique
  locations Location[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Location {
  id                   String           @id @default(cuid())
  warehouseId          String?          
  warehouse            Warehouse?       @relation(fields: [warehouseId], references: [id])
  name                 String           // e.g. "Main Store", "Rack A", "Production Floor"
  isInternal           Boolean          @default(true) // External locations for vendors/customers
  quants               StockQuant[]
  sourceOperations     StockOperation[] @relation("SourceLocation")
  destOperations       StockOperation[] @relation("DestLocation")
  sourceLedgerEntries  StockLedger[]    @relation("LedgerSource")
  destLedgerEntries    StockLedger[]    @relation("LedgerDest")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model Product {
  id              String         @id @default(cuid())
  name            String
  sku             String         @unique
  category        String
  uom             String         @default("Units")
  minReorderLevel Int            @default(0)
  quants          StockQuant[]
  moves           StockMove[]
  ledgerEntries   StockLedger[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model StockQuant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  quantity   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, locationId])
}

model StockOperation {
  id               String        @id @default(cuid())
  type             String        // RECEIPT, DELIVERY, INTERNAL, ADJUSTMENT
  status           String        // DRAFT, WAITING, READY, DONE, CANCELED
  sourceLocationId String?
  sourceLocation   Location?     @relation("SourceLocation", fields: [sourceLocationId], references: [id])
  destLocationId   String?
  destLocation     Location?     @relation("DestLocation", fields: [destLocationId], references: [id])
  moves            StockMove[]
  ledgerEntries    StockLedger[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model StockMove {
  id          String         @id @default(cuid())
  operationId String
  operation   StockOperation @relation(fields: [operationId], references: [id])
  productId   String
  product     Product        @relation(fields: [productId], references: [id])
  qty         Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model StockLedger {
  id               String          @id @default(cuid())
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  sourceLocationId String?
  sourceLocation   Location?       @relation("LedgerSource", fields: [sourceLocationId], references: [id])
  destLocationId   String?
  destLocation     Location?       @relation("LedgerDest", fields: [destLocationId], references: [id])
  qty              Int
  operationId      String?
  operation        StockOperation? @relation(fields: [operationId], references: [id])
  timestamp        DateTime        @default(now())
}
